{
  "info": {
    "name": "Shopping List API",
    "description": "CRUD requests and validation checks for the Shopping List API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "itemId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Items",
      "item": [
        {
          "name": "Get all items",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/items"
          }
        },
        {
          "name": "Create item",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('itemId', json.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Milk\",\n  \"quantity\": 2,\n  \"purchased\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/items"
          }
        },
        {
          "name": "Get item by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/items/{{itemId}}"
          }
        },
        {
          "name": "Update item",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 3,\n  \"purchased\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/items/{{itemId}}"
          }
        },
        {
          "name": "Delete item",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/items/{{itemId}}"
          }
        }
      ]
    },
    {
      "name": "Validation and errors",
      "item": [
        {
          "name": "Reject missing name",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/items"
          }
        },
        {
          "name": "Reject unknown item",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/items/does-not-exist"
          }
        }
      ]
    }
  ]
}
